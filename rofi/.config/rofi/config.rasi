configuration {
    modi: "drun,run";
    show-icons: true;
    font: "Fira Sans 14";
}

@theme "/dev/null"

* {
    /* Transparent background */
    bg: rgba(26, 26, 26, 0.85);
    bg-selected: rgba(255, 255, 255, 0.1);
    
    fg: #ffffff;
    accent: #33ccff;
    
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 600px;
    background-color: @bg;
    border: 2px;
    border-color: rgba(51, 204, 255, 0.8);
    border-radius: 15px;
    padding: 20px;
}

mainbox {
    spacing: 15px;
}

inputbar {
    background-color: @bg-selected;
    border-radius: 10px;
    padding: 10px;
    spacing: 10px;
}

entry {
    placeholder: "Search Apps...";
    placeholder-color: rgba(255, 255, 255, 0.5);
    text-color: @fg;
}

listview {
    lines: 7;
    spacing: 5px;
    scrollbar: false;
}

element {
    padding: 10px;
    border-radius: 10px;
    spacing: 10px;
}

element selected {
    background-color: @bg-selected;
    border: 1px;
    border-color: @accent;
}

element-icon {
    size: 24px;
}

element-text {
    vertical-align: 0.5;
}
